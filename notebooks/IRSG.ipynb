    "MAX_LINES = [x for x in range(ROUTE_AMOUNT[CITY_NAME] - 5, ROUTE_AMOUNT[CITY_NAME] + 5)]\n",
    "WALK_DISTANCE = WALKING_DISTANCES[WD_TO_USE] # WALKING_DISTANCES ->  500, 750, 1000 (changed from 300,550,800)\n",
    "\n",
    "SEED = 100\n",
    "\n",
    "\n",
    "def make_run_tag():\n",
    "  return (f\"w{int(WALK_DISTANCE)}_s{STOP_MIN}_r{ROUTE_AMOUNT[CITY_NAME]}_n{NUM_OF_NETWORKS}\")\n",
    "\n",
    "run_tag = make_run_tag()\n",
    "\n",
    "TARGET_GEN_DIR = f\"../data/initial_route_sets/{CITY_NAME}\"\n",
    "os.makedirs(TARGET_GEN_DIR, exist_ok=True)\n",
    "\n",
    "file_path = os.path.join(TARGET_GEN_DIR, f\"{CITY_NAME}_population_{run_tag}.pkl\")\n",
    "# file_path = os.path.join(TARGET_GEN_DIR, f\"{CITY_NAME}_population.pkl\")\n",
    "file_path_checkpoint = os.path.join(TARGET_GEN_DIR, f\"{CITY_NAME}_checkpoint_population.pkl\")\n",
    "\n",
    "def worker(i):\n",
    "  rand = random.Random(SEED + i)\n",
    "  route_network, route_graph = generate_route_network(\n",
    "      list_of_stops,\n",
    "      WALK_DISTANCE,\n",
    "      rand.choice(MAX_STOPS),\n",
    "      rand.choice(MAX_LINES),\n",
    "      graph_of_stops,\n",
    "      city_area_sum\n",
    "  )\n",
    "  return Network(routes=route_network, graph=route_graph)\n",
    "\n",
    "initial_population = []\n",
    "\n",
    "# with ThreadPoolExecutor() as exec:\n",
    "#   futures = [exec.submit(worker, i) for i in range(NUM_OF_NETWORKS)]\n",
    "\n",
    "#   for idx, future in enumerate(as_completed(futures), 1):\n",
    "#     net = future.result()\n",
    "#     initial_population.append(net)\n",
    "\n",
    "# save_data(initial_population, file_path)\n",
    "# print(f\"Saved {len(initial_population)} networks to {file_path}.\")\n",
    "\n",
    "N_WORKERS = 50\n",
    "ctx = mp.get_context(\"fork\")\n",
    "with ProcessPoolExecutor(max_workers=N_WORKERS, mp_context=ctx) as exec:\n",
    "  futures = [exec.submit(worker, i) for i in range(NUM_OF_NETWORKS)]\n",
    "\n",
    "  for idx, future in enumerate(as_completed(futures), 1):\n",
    "    net = future.result()\n",
    "    initial_population.append(net)\n",
    "    if idx % 5 == 0 or idx == NUM_OF_NETWORKS:\n",
    "      save_data(initial_population, file_path_checkpoint)\n",
    "\n",
    "save_data(initial_population, file_path)\n",
    "print(f\"Saved {len(initial_population)} networks to {file_path}.\")"
   ]
  },
