    "## Route Connection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "116ad36d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# V2 - Graph with the snapping function\n",
    "# Generate Route Network from connected routes\n",
    "def generate_route_network(stop_nodes: list[Stop], max_walking_dist: int, max_stops: int, max_lines: int, graph_of_stops, city_area_sum: float):\n",
    "    net_start_time = time.perf_counter()\n",
    "    nodes_yx = {n: (data['y'], data['x']) for n, data in graph_of_stops.nodes(data=True)}\n",
    "\n",
    "    overall_graph = nx.MultiDiGraph() # The route network graph\n",
    "    route_network = []\n",
    "\n",
    "    num_lines = 0 # Line counter\n",
    "    max_attempts, attempts = max_lines * 10, 0  # Prevent infinite loop if valid lines cannot be formed\n",
    "\n",
    "    print(f\"Target: {max_lines} lines | Max attempts: {max_attempts}\")\n",
    "    while num_lines < max_lines and attempts < max_attempts:\n",
    "        line_id = num_lines\n",
    "        forward_route_id = f\"{line_id}-F\"\n",
    "\n",
    "        next_nodes = [n for n in stop_nodes] # Resets the list of nodes so that nodes can be reused in a different\n",
    "        selected_node = random.choice(next_nodes) # For the first node\n",
    "        next_nodes.remove(selected_node)\n",
    "\n",
    "        # Generate forward route\n",
    "        route_gen, route_length = generate_route(\n",
    "            selected_node, next_nodes, max_walking_dist, max_stops,\n",
    "            overall_graph, city_area_sum, forward_route_id, graph_of_stops, nodes_yx\n",
    "        )\n",
    "\n",
    "        if len(route_gen) > 1:\n",
    "            forward_route = Route(route_gen, forward_route_id, route_length, line_id, direction=\"forward\") # Create a new route object to store the Route ID and the route itself\n",
    "\n",
    "            # Snap the forward route to the graph\n",
    "            add_to_graph(route_gen, overall_graph, graph_of_stops, forward_route_id, nodes_yx)\n",
    "            route_network.append(forward_route)\n",
    "\n",
    "            # Get the reverse route and add it to the graph\n",
    "            reverse_route = get_reverse_route(forward_route, graph_of_stops, nodes_yx)\n",
    "\n",
    "            if reverse_route is not None:\n",
    "                add_to_graph(reverse_route.route, overall_graph, graph_of_stops, reverse_route.route_id, nodes_yx)\n",
    "                route_network.append(reverse_route)\n",
    "                print(f\"  └─ Line {line_id} COMPLETE: Forward ({route_length:.2f} km) + Reverse ({reverse_route.length:.2f} km)\")\n",
    "            else:\n",
    "                print(f\"  └─ Line {line_id} PARTIAL: Forward added ({route_length:.2f} km), Reverse FAILED\")\n",
    "\n",
    "            num_lines += 1\n",
    "\n",
    "        else:\n",
    "            print(f\"  [Attempt {attempts}] Failed to generate valid forward route for Line {line_id}. Retrying...\")\n",
    "\n",
    "    net_elapsed = time.perf_counter() - net_start_time\n",
    "    print(f\"Finished: {num_lines}/{max_lines} lines created in {attempts} attempt(s). Done in {net_elapsed:.2f}s.\")\n",
    "    return route_network, overall_graph\n",
    "\n",
    "def add_to_graph(route, overall_graph, graph_of_stops, route_id, nodes_yx):\n",
    "    # Directly add nodes based on node identifiers\n",
    "    for connection in route:\n",
    "        u_node = connection[0]\n",
    "        v_node = connection[-1]\n",
    "\n",
    "        overall_graph.add_node(u_node, **graph_of_stops.nodes[u_node]) # The origin\n",
    "        overall_graph.add_node(v_node, **graph_of_stops.nodes[v_node]) # The destination\n",
    "\n",
    "        distance_travelled = 0\n",
    "        # Get the total distance from point A to point B\n",
    "        for i in range(len(connection) - 1):\n",
    "            ay, ax = nodes_yx[connection[i]]\n",
    "            by, bx = nodes_yx[connection[i+1]]\n",
    "\n",
    "            distance_travelled += geodesic((ay, ax), (by, bx)).kilometers\n",
    "\n",
    "        # Finally, Add the edge\n",
    "        overall_graph.add_edge(u_node, v_node, key=route_id, road_path=connection, distance=distance_travelled)\n",
    "\n",
    "# Generate route from stop nodes\n",
    "def generate_route(source: Stop, next_nodes: list[Stop], max_walking_dist: int, max_stops: int, network_graph: MultiDiGraph, city_area_sum: float, route_id: str, graph_of_stops: nx.MultiDiGraph, nodes_yx: dict):\n",
    "    short_route_list = [] # List of nx.shortest_path results\n",
    "    total_distance = 0.0\n",
    "    orig_node = source\n",
    "    num_stops = 0 # Count number of stops\n",
    "\n",
    "    # Configuration\n",
    "    max_tries = 5 # This is the max number of tries before breaking the loop || To avoid longer runtimes\n",
    "    current_tries = 0\n",
    "\n",
    "    while total_distance < MAX_DISTANCE and num_stops < max_stops:\n",
    "        enable_nodes(next_nodes)\n",
    "        disable_surrounding_nodes(next_nodes, orig_node, max_walking_dist)\n",
    "        enabled_nodes = [n for n in next_nodes if n.enabled]\n",
    "        if len(enabled_nodes) == 0:\n",
    "            break\n",
    "\n",
    "        # print(f\"{len(enabled_nodes)} nodes out of {len(next_nodes)}\")\n",
    "\n",
    "        # Getting the destination node\n",
    "        dest_node = get_enabled_node_with_highest_edge_probability(orig_node, enabled_nodes, city_area_sum, network_graph)\n",
    "\n",
    "        if (dest_node == None or dest_node.stop_id == orig_node.stop_id):\n",
    "            break\n",
    "\n",
    "        # Remove it as a candidate\n",
    "        next_nodes.remove(dest_node)\n",
    "\n",
    "        # This is to check if there is already an exiting edge in the route. If true, then it should not connect\n",
    "        connection_edge1 = network_graph.has_edge(orig_node.stop_id, dest_node.stop_id, route_id)\n",
    "        connection_edge2 = network_graph.has_edge(dest_node.stop_id, orig_node.stop_id, route_id)\n",
    "\n",
    "        # If there is already an existing edge in either direction for this route_id, do not connect\n",
    "        if connection_edge1 or connection_edge2:\n",
    "            current_tries += 1\n",
    "            if current_tries == max_tries:\n",
    "                break\n",
    "            continue  # important: skip trying shortest path\n",
    "\n",
    "        # Try to get shortest path (cached). If no path exists, treat like nx.has_path == False.\n",
    "        try:\n",
    "            shortest_route = nx.shortest_path(graph_of_stops, orig_node.stop_id, dest_node.stop_id, weight='length')\n",
    "        except nx.NetworkXNoPath:\n",
    "            current_tries += 1\n",
    "            if current_tries == max_tries:\n",
    "                break\n",
    "            continue\n",
    "\n",
    "        # Get the total distance from point A to point B\n",
    "        distance_travelled = 0\n",
    "        for i in range(len(shortest_route)-1):\n",
    "           ay, ax = nodes_yx[shortest_route[i]]\n",
    "           by, bx = nodes_yx[shortest_route[i+1]]\n",
    "           distance_travelled += geodesic((ay, ax), (by, bx)).kilometers\n",
    "\n",
    "        # Checks if it does not exceed the max distance\n",
    "        if total_distance + distance_travelled <= MAX_DISTANCE:\n",
    "            # Updating local degree count used for connection probability\n",
    "            orig_node.degree += 1\n",
    "            dest_node.degree += 1\n",
    "\n",
    "            total_distance += distance_travelled\n",
    "            short_route_list.append(shortest_route)\n",
    "            num_stops += 1\n",
    "\n",
    "            orig_node = dest_node # Now change the origin to the destination\n",
    "        else:\n",
    "            break\n",
    "\n",
    "    if len(short_route_list) > 4 and total_distance > 7:\n",
    "        return short_route_list, total_distance\n",
    "\n",
    "    else:\n",
    "        return [], []"
   ]
